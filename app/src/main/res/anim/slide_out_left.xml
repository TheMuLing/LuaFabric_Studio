<?xml version="1.0" encoding="utf-8"?>
<!-- 向左侧滑出（进入详情时，下层页面退左） -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic">
    <translate
        android:fromXDelta="0"
        android:toXDelta="-30%"
        android:duration="300" />
</set>
