<?xml version="1.0" encoding="utf-8"?>
<!-- 从左侧滑入（返回时，下层页面回位） -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <translate
        android:fromXDelta="-30%"
        android:toXDelta="0"
        android:duration="300" />
</set>
